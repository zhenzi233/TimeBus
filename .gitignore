.gradle
**/build/
!src/**/build/
run/
out/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IDEA config
.idea

# Design source files (not committed)
*.psb
*.psd

# Local-only files (kept locally, not uploaded)
MCMOD_CN.md
time_bus_base.blockbench.bak

# CurseForge 发布脚本的 npm 依赖（gradle/scripts 下 node modules）
node_modules/
gradle/scripts/node_modules/
gradle/scripts/package.json
gradle/scripts/package-lock.json
