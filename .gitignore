.gradle
**/build/
!src/**/build/
run/
out/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IDEA config
.idea

# Design source files: the editable originals live in design/ and ARE tracked
# (they are the masters for the shipped PNGs). Everywhere else *.psd / *.psb
# stay ignored, so they can never sneak back into src/main/resources and get
# packaged into the jar -- see design/README.md and build.gradle's
# processResources exclude.
*.psb
*.psd
!design/**

# Local-only files (kept locally, not uploaded)
MCMOD_CN.md
time_bus_base.blockbench.bak

# CurseForge 发布脚本的 npm 依赖（gradle/scripts 下 node modules）
node_modules/
gradle/scripts/node_modules/
gradle/scripts/package.json
gradle/scripts/package-lock.json
