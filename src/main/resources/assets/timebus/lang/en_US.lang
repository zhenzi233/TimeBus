# --- Config screen (used by Forge config GUI) ---
config.timebus.title=Time Bus Configuration
config.timebus.speedMultipliers=Speed Multipliers
config.timebus.speedMultipliers.tooltip=Per-card speed multipliers, comma-separated.\nNth value = speed when N-1 cards are installed.\nIf more cards than values, the last value repeats.\nExample: 2,4,8,16,32 -> 0 cards=2x, 1 card=4x, 2 cards=8x, 3 cards=16x, 4 cards=32x
config.timebus.idlePower=Idle Power Draw (AE/t)
config.timebus.idlePower.tooltip=Power drawn per tick when idle (no acceleration happening). Default: 1.0
config.timebus.powerPerSpeed=Power Cost per Speed Unit
config.timebus.powerPerSpeed.tooltip=Power cost multiplier. Total cost per tick = max(idlePower, effectiveSpeed * powerPerSpeed). Default: 0.5
config.timebus.fluidMode=Fluid Mode Enabled
config.timebus.fluidMode.tooltip=If true, the Time Bus consumes fluid from the ME network to operate, instead of AE power.
config.timebus.fluidName=Consumed Fluid
config.timebus.fluidName.tooltip=The registry name of the fluid to consume (e.g. 'water', 'lava'). Default: water
config.timebus.fluidPerTick=Fluid per Tick (mB)
config.timebus.fluidPerTick.tooltip=Millibuckets of fluid consumed per tick when accelerating. Supports decimals (e.g. 0.1 = 1 mB per 10 ticks). Default: 1.0
config.timebus.fluidConsumeMultiplier=Fluid Consumption Multiplier (per card)
config.timebus.fluidConsumeMultiplier.tooltip=Each speed card multiplies fluid consumption by this value. Actual rate = fluidPerTick * (this ^ cardCount). Default: 2.0
config.timebus.minFluid=Minimum Fluid (mB)
config.timebus.minFluid.tooltip=Minimum amount of fluid in the ME network before the Time Bus will start consuming it. Default: 1000 (= 1 bucket)
config.timebus.capacityWidths=Capacity Widths
config.timebus.capacityWidths.tooltip=Per-card acceleration widths, comma-separated.\nNth value = width when N-1 cards are installed (1 = single block).\nIf more cards than values, the last value repeats.\nExample: 1,3,9,15 -> 0 cards=1, 1 card=3, 2 cards=9, 3 cards=15
config.timebus.maxCallsPerTick=Max Calls per Tick (Work Budget)
config.timebus.maxCallsPerTick.tooltip=Maximum number of acceleration calls (tile updates + random ticks) executed per server tick.\nWork beyond this budget is carried over to the next tick, keeping the server tick smooth even with max speed cards and a wide range. Default: 128
config.timebus.matterBallUnit=Matter Ball Unit Value
config.timebus.matterBallUnit.tooltip=How many progress units one Matter Ball contributes. Default: 1
config.timebus.singularityUnit=Singularity Unit Value
config.timebus.singularityUnit.tooltip=How many progress units one Singularity contributes.\nA Singularity is worth 1000 Matter Balls, so progress is preserved when the input mode is switched mid-way. Default: 1000
config.timebus.unitsPerBatch=Units per Batch
config.timebus.unitsPerBatch.tooltip=Total progress units needed to produce one batch of Time Fluid.\n64000 units = 64000 Matter Balls or 64 Singularities. Default: 64000
config.timebus.timeFluidPerBatch=Time Fluid per Batch (mB)
config.timebus.timeFluidPerBatch.tooltip=How many millibuckets of Time Fluid one full batch produces. Default: 1000
config.timebus.wandSpeedMultipliers=Wand Speed Multipliers
config.timebus.wandSpeedMultipliers.tooltip=Per-card speed multipliers for the Time Wand, comma-separated.\nNth value = speed when N-1 speed cards are installed in the wand (cards are placed via an AE2 cell workbench).\nIf more cards than values, the last value repeats.\nExample: 2,4,8,16,32 -> 0 cards=2x, 1 card=4x, 2 cards=8x, 3 cards=16x, 4 cards=32x\nThis is independent from the Time Bus speedMultipliers.
config.timebus.wandFluidCost=Wand Fluid Cost (mB)
config.timebus.wandFluidCost.tooltip=Millibuckets of Time Fluid consumed per wand use (shift + right-click). Default: 10
config.timebus.wandEnergyCost=Wand Energy Cost (AE)
config.timebus.wandEnergyCost.tooltip=AE energy consumed per wand use (shift + right-click). Default: 1000